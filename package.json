{
  "name": "esp32-websocket-classroom",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n SERVER,WEBSITE \"npm run start -w server\" \"npm run dev -w client\"",
    "server": "npm run start -w server",
    "client": "npm run dev -w client",
    "build": "npm run build -w client",
    "test": "node --test server/server.test.js client/src/websocket/websocketClient.test.js"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
